{
  "name": "prop-dashboard-flenkenz",
  "productName": "Prop Dashboard",
  "version": "1.2.0",
  "description": "Prop Dashboard by Flenkenz — Trading-Dashboard als Windows-Desktop-App / PWA",
  "main": "main.js",
  "author": "Flenkenz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.flenkenz.prop-dashboard",
    "productName": "Prop Dashboard",
    "files": [
      "main.js",
      "index.html",
      "manifest.json",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "Prop-Dashboard-${version}-portable.exe"
    }
  }
}
